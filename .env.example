# ============================================================
# Cloudnaut Support Desk — environment example
# Copy to .env for LOCAL development. Never commit real secrets.
# In AWS, SECRET values are injected from AWS Secrets Manager into the
# container environment at boot (not from this file).
# ============================================================

# ---------- SECRETS (AWS: store in Secrets Manager) ----------
# JWT signing key (HS256). Generate a long random value.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
# Local Postgres password (local dev only). In AWS the DB password is part of
# DATABASE_URL, sourced from the Aurora-managed Secrets Manager secret.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Full SQLAlchemy URL. Local dev (docker-compose) builds this from
# POSTGRES_PASSWORD automatically; set it explicitly for Aurora:
#   postgresql+psycopg2://USER:PASSWORD@AURORA_ENDPOINT:5432/cloudnaut_db
# DATABASE_URL=

# SES SMTP credentials (Phase 2 — AWS: Secrets Manager). Leave empty locally.
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- APPLICATION CONFIG (non-secret) ----------
# S3 attachment storage (AWS). Bucket is created by CDK; credentials come from
# the EC2 IAM role via the AWS provider chain (no access keys here).
S3_BUCKET=
AWS_REGION=

# Email (SES). For production:
#   SMTP_HOST=email-smtp.<AWS_REGION>.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_FROM_EMAIL=<verified-sender@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=

# Frontend origin (used for password-reset links / CORS later).
FRONTEND_URL=http://localhost:3000

# ============================================================
# Amazon Cognito authentication (phased migration)
# ============================================================
# Authentication mode for BOTH FastAPI tiers (api + backend):
#   legacy  -> existing HS256 app tokens only (DEFAULT; no behaviour change)
#   dual    -> accept a valid Cognito access token OR a legacy token
#   cognito -> Cognito access tokens only
# Leave as legacy until Cognito is deployed, users are migrated, and you have
# explicitly decided to cut over.
AUTH_MODE=legacy

# Cognito identifiers (NON-SECRET). Populate after deploying the CDK stack from
# its outputs (CognitoUserPoolId / CognitoAppClientId). Required when AUTH_MODE
# is dual or cognito.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# AWS_REGION is already defined above (reused for Cognito issuer/JWKS).

# ---- Frontend (Vite) — all PUBLIC, safe to embed in the browser bundle ----
# Mirror of AUTH_MODE for the SPA. Default legacy keeps the existing login UI.
VITE_AUTH_MODE=legacy
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_AWS_REGION=ap-south-1
