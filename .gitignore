# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
# The frontend production build config is PUBLIC (API Gateway URL + Cognito
# pool/client IDs + region — all embedded in the browser bundle anyway). It
# MUST be committed so the CI/CD frontend build produces a correctly-configured
# bundle; without it the deployed SPA would have no API URL / Cognito config.
!workspace/frontend/.env.production

# ---------------------------------------------------------
# Local databases
# ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Local database backups and generated analysis
backups/
.codegraph/
