# Production build config for the Cloudnaut Support Desk frontend.
# Vite embeds VITE_* vars into the client bundle at `npm run build`.
# This is the PUBLIC API Gateway URL only — do NOT put secrets here.
VITE_API_URL=https://91kwn8bs53.execute-api.ap-south-1.amazonaws.com



# Amazon Cognito (PUBLIC values only — no secrets). These make Cognito the
# single active login flow in the production build.
VITE_AUTH_MODE=cognito
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_ywRrGmxpM
VITE_COGNITO_APP_CLIENT_ID=36hud2677sjbeb1qjov197fmai
